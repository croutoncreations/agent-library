{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["packages/self-host/src/**/*.js", "packages/core/src/**/*.js", "packages/core/src/**/*.ts", "packages/core/src/**/*.d.ts"],
  "exclude": ["packages/core/src/web/**"]
}
